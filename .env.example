# ---------- Factorio / FactorioMCP ----------
FACTORIO_PLAYER_NAME=Noxis
FACTORIO_RCON_HOST=127.0.0.1
FACTORIO_RCON_PORT=27015
FACTORIO_RCON_PASSWORD=
FACTORIO_MCP_PROJECT=src/FactorioMCP/FactorioMCP/FactorioMCP.csproj

# ---------- Cloud model provider ----------
# openai = OpenAI Responses API, either directly or through your Cloudflare Worker
# deepseek = DeepSeek directly
AI_PROVIDER=openai

# ---------- OpenAI Responses API ----------
# Direct OpenAI:
OPENAI_BASE_URL=https://api.openai.com/v1
# For direct OpenAI, use the real OpenAI API key here.
# For a Cloudflare Worker, set OPENAI_BASE_URL to the Worker /v1 URL and put
# WORKER_SHARED_SECRET here instead; the real OpenAI key then stays in Cloudflare.
OPENAI_API_KEY=
# Sol is the primary planner/executor. The orchestrator reduces context/action-space instead of delegating planning to a weaker model.
OPENAI_MODEL=gpt-5.6-sol
# Automatically compact long stateful Responses chains before repeated cached input grows without bound.
# Set to 0 to disable automatic context compaction.
OPENAI_CONTEXT_COMPACT_TOKENS=80000

# ---------- DeepSeek direct ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# ---------- Agent limits ----------
AGENT_MAX_TURNS=40
# Pre-validation safety cap. Read-only tools and walking do not consume it.
AGENT_MAX_MUTATIONS=80
# A validated factory build can legitimately require hundreds of additive belt/pole placements.
# This allowance is added only after PLAN_VALID; destructive operations remain plan-guarded.
AGENT_EXECUTION_EXTRA_MUTATIONS=240
# Extra cloud turns granted only after PLAN_VALID.
AGENT_EXECUTION_EXTRA_TURNS=40
# Stop further mutations early when too many mutation attempts fail, to prevent tool thrashing.
AGENT_MAX_FAILED_MUTATIONS=8
# Keep stateful cloud context bounded. Broad scan tools have even smaller built-in caps.
AGENT_TOOL_RESULT_MAX_CHARS=20000
# In plan-gated mode expose only the tools relevant to planning, execution, or verification.
# Set to 0 only when debugging an upstream MCP tool that is missing from a phase allowlist.
AGENT_PHASE_TOOL_FILTER=1
