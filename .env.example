# ---------- Factorio / FactorioMCP ----------
FACTORIO_PLAYER_NAME=Noxis
FACTORIO_RCON_HOST=127.0.0.1
FACTORIO_RCON_PORT=27015
FACTORIO_RCON_PASSWORD=
FACTORIO_MCP_PROJECT=src/FactorioMCP/FactorioMCP/FactorioMCP.csproj

# ---------- Cloud model provider ----------
# openai = OpenAI through your Cloudflare Worker
# deepseek = DeepSeek directly, without the Worker
AI_PROVIDER=deepseek

# ---------- OpenAI through Cloudflare Worker ----------
OPENAI_BASE_URL=https://factorio-ai.ilitasuka1448.workers.dev/v1
# This is WORKER_SHARED_SECRET, NOT the real OpenAI key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# ---------- DeepSeek direct ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# ---------- Agent limits ----------
AGENT_MAX_TURNS=80
AGENT_TOOL_RESULT_MAX_CHARS=50000
